.lxr-toolbar.lxr-dawn
  border: 1px solid borderColor
  box-sizing: border-box
  font-family: 'Georgia', 'Iowan Old Style', 'Palatino Linotype', serif
  padding: 8px
  background-color: #fff7ed

  .lxr-formats
    margin-right: 15px

  .lxr-picker-label
    border: 1px solid transparent
  .lxr-picker-options
    border: 1px solid borderColor
    box-shadow: shadowColor 0 4px 14px
    background-color: backgroundColor
  .lxr-picker.lxr-expanded
    .lxr-picker-label
      border-color: #fdba74
    .lxr-picker-options
      border-color: #fdba74

  .lxr-color-picker
    .lxr-picker-item.lxr-selected, .lxr-picker-item:hover
      border-color: activeColor

.lxr-toolbar.lxr-dawn + .lxr-container.lxr-dawn
  border-top: 0px

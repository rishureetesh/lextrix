.lxt-toolbar.lxt-dawn
  border: 1px solid borderColor
  box-sizing: border-box
  font-family: 'Georgia', 'Iowan Old Style', 'Palatino Linotype', serif
  padding: 8px
  background-color: #fff7ed

  .lxt-formats
    margin-right: 15px

  .lxt-picker-label
    border: 1px solid transparent
  .lxt-picker-options
    border: 1px solid borderColor
    box-shadow: shadowColor 0 4px 14px
    background-color: backgroundColor
  .lxt-picker.lxt-expanded
    .lxt-picker-label
      border-color: #fdba74
    .lxt-picker-options
      border-color: #fdba74

  .lxt-color-picker
    .lxt-picker-item.lxt-selected, .lxt-picker-item:hover
      border-color: activeColor

.lxt-toolbar.lxt-dawn + .lxt-container.lxt-dawn
  border-top: 0px

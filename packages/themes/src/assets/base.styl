// Styles shared between snow and bubble

controlHeight = 26px
inputPaddingWidth = 4px
inputPaddingHeight = 2px

colorItemMargin = 2px
colorItemSize = 16px
colorItemsPerRow = 7


.lxr-{themeName}.lxr-toolbar, .lxr-{themeName} .lxr-toolbar
  &:after
    clear: both
    content: ''
    display: table

  button
    background: none
    border: none
    cursor: pointer
    display: inline-block
    float: left
    height: controlHeight
    padding: inputPaddingHeight inputPaddingWidth
    width: controlHeight + (inputPaddingWidth - inputPaddingHeight)*2

    svg
      float: left
      height: 100%

    &:active:hover
      outline: none

  input.lxr-image[type=file]
    display: none

  button:hover, button:focus, button.lxr-active,
  .lxr-picker-label:hover, .lxr-picker-label.lxr-active,
  .lxr-picker-item:hover, .lxr-picker-item.lxr-selected
    color: activeColor
    .lxr-fill, .lxr-stroke.lxr-fill
      fill: activeColor
    .lxr-stroke, .lxr-stroke-miter
      stroke: activeColor

// Fix for iOS not losing hover on touch
@media (pointer: coarse)
  .lxr-{themeName}.lxr-toolbar, .lxr-{themeName} .lxr-toolbar
    button:hover:not(.lxr-active)
      color: inactiveColor
      .lxr-fill, .lxr-stroke.lxr-fill
        fill: inactiveColor
      .lxr-stroke, .lxr-stroke-miter
        stroke: inactiveColor

.lxr-{themeName}
  box-sizing: border-box
  *
    box-sizing: border-box

  .lxr-hidden
    display: none
  .lxr-out-bottom, .lxr-out-top
    visibility: hidden

  .lxr-tooltip
    position: absolute
    transform: translateY(10px)
    a
      cursor: pointer
      text-decoration: none
  .lxr-tooltip.lxr-flip
    transform: translateY(-10px)

  .lxr-formats
    &:after
      clear: both
      content: ''
      display: table
    display: inline-block
    vertical-align: middle

  .lxr-stroke
    fill: none
    stroke: inactiveColor
    stroke-linecap: round
    stroke-linejoin: round
    stroke-width: 1.75
  .lxr-stroke-miter
    fill: none
    stroke: inactiveColor
    stroke-miterlimit: 10
    stroke-width: 1.75

  .lxr-fill, .lxr-stroke.lxr-fill
    fill: inactiveColor

  .lxr-toolbar button svg,
  .lxr-picker-label svg
    transition: fill 120ms ease, stroke 120ms ease, opacity 120ms ease

  button.lxr-active svg,
  button:hover svg,
  button:focus svg
    .lxr-stroke:not(.lxr-thin), .lxr-stroke-miter:not(.lxr-thin)
      stroke-width: 2

  .lxr-empty
    fill: none
  .lxr-even
    fill-rule: evenodd
  .lxr-thin, .lxr-stroke.lxr-thin
    stroke-width: 1
  .lxr-transparent
    opacity: 0.4

  .lxr-direction
    svg:last-child
      display: none
  .lxr-direction.lxr-active
    svg:last-child
      display: inline
    svg:first-child
      display: none

  .lxr-editor
    h1
      font-size: 2em
    h2
      font-size: 1.5em
    h3
      font-size: 1.17em
    h4
      font-size: 1em
    h5
      font-size: 0.83em
    h6
      font-size: 0.67em
    a
      text-decoration: underline
    blockquote
      border-left: 4px solid #ccc
      margin-bottom: 5px
      margin-top: 5px
      padding-left: 16px
    code, .lxr-code-block-container
      background-color: #f0f0f0
      border-radius: 3px
    .lxr-code-block-container
      margin-bottom: 5px
      margin-top: 5px
      padding: 5px 10px
    code
      font-size: 85%
      padding: 2px 4px
    .lxr-code-block-container
      background-color: #23241f
      color: #f8f8f2
      overflow: visible
    img
      max-width: 100%

  .lxr-picker
    color: inactiveColor
    display: inline-block
    float: left
    font-size: 14px
    font-weight: 500
    height: controlHeight
    position: relative
    vertical-align: middle
  .lxr-picker-label
    cursor: pointer
    display: inline-block
    height: 100%
    padding-left: 8px
    padding-right: 2px
    position: relative
    width: 100%
    &::before
      display: inline-block
      line-height: 22px
  .lxr-picker-options
    background-color: backgroundColor
    display: none
    min-width: 100%
    padding: 4px 8px
    position: absolute
    white-space: nowrap
    .lxr-picker-item
      cursor: pointer
      display: block
      padding-bottom: 5px
      padding-top: 5px
  .lxr-picker.lxr-expanded
    .lxr-picker-label
      color: borderColor
      z-index: 2
      .lxr-fill
        fill: borderColor
      .lxr-stroke
        stroke: borderColor
    .lxr-picker-options
      display: block
      margin-top: -1px
      top: 100%
      z-index: 1

  .lxr-color-picker, .lxr-icon-picker
    width: controlHeight + 4
    .lxr-picker-label
      padding: 2px 4px
      svg
        right: 4px
  .lxr-icon-picker
    .lxr-picker-options
      padding: 4px 0px
    .lxr-picker-item
      height: controlHeight
      width: controlHeight
      padding: 2px 4px
  .lxr-color-picker
    .lxr-picker-options
      padding: inputPaddingHeight inputPaddingWidth
      width: (colorItemSize + 2*colorItemMargin) * colorItemsPerRow + 2*inputPaddingWidth + 2  // +2 for the border
    .lxr-picker-item
      border: 1px solid transparent
      float: left
      height: colorItemSize
      margin: colorItemMargin
      padding: 0px
      width: colorItemSize

  .lxr-picker:not(.lxr-color-picker):not(.lxr-icon-picker)
    svg
      position: absolute
      margin-top: -9px
      right: 0
      top: 50%
      width: 18px

  .lxr-picker.lxr-header, .lxr-picker.lxr-font, .lxr-picker.lxr-size
    .lxr-picker-label[data-label]:not([data-label='']),
    .lxr-picker-item[data-label]:not([data-label=''])
      &::before
        content: attr(data-label)

  .lxr-picker.lxr-header
    width: 98px
    .lxr-picker-label::before,
    .lxr-picker-item::before
      content: 'Normal'
    for num in (1..6)
      .lxr-picker-label[data-value=\"{num}\"]::before,
      .lxr-picker-item[data-value=\"{num}\"]::before
        content: 'Heading ' + num
    .lxr-picker-item[data-value="1"]::before
      font-size: 2em
    .lxr-picker-item[data-value="2"]::before
      font-size: 1.5em
    .lxr-picker-item[data-value="3"]::before
      font-size: 1.17em
    .lxr-picker-item[data-value="4"]::before
      font-size: 1em
    .lxr-picker-item[data-value="5"]::before
      font-size: 0.83em
    .lxr-picker-item[data-value="6"]::before
      font-size: 0.67em

  .lxr-picker.lxr-font
    width: 108px
    .lxr-picker-label::before,
    .lxr-picker-item::before
      content: 'Sans Serif'
    .lxr-picker-label[data-value=serif]::before,
    .lxr-picker-item[data-value=serif]::before
      content: 'Serif'
    .lxr-picker-label[data-value=monospace]::before,
    .lxr-picker-item[data-value=monospace]::before
      content: 'Monospace'
    .lxr-picker-item[data-value=serif]::before
      font-family: Georgia, Times New Roman, serif
    .lxr-picker-item[data-value=monospace]::before
      font-family: Monaco, Courier New, monospace

  .lxr-picker.lxr-size
    width: 98px
    .lxr-picker-label::before,
    .lxr-picker-item::before
      content: 'Normal'
    .lxr-picker-label[data-value=small]::before,
    .lxr-picker-item[data-value=small]::before
      content: 'Small'
    .lxr-picker-label[data-value=large]::before,
    .lxr-picker-item[data-value=large]::before
      content: 'Large'
    .lxr-picker-label[data-value=huge]::before,
    .lxr-picker-item[data-value=huge]::before
      content: 'Huge'
    .lxr-picker-item[data-value=small]::before
      font-size: 10px
    .lxr-picker-item[data-value=large]::before
      font-size: 18px
    .lxr-picker-item[data-value=huge]::before
      font-size: 32px

  .lxr-color-picker.lxr-background
    .lxr-picker-item
      background-color: #fff
  .lxr-color-picker.lxr-color
    .lxr-picker-item
      background-color: #000

.lxr-code-block-container
  position: relative
  .lxr-ui
    right: 5px
    top: 5px

.lxr-container
  position: relative

.lxr-image-resize
  border: 1px solid activeColor
  box-sizing: border-box
  pointer-events: none
  position: absolute
  z-index: 2

.lxr-image-resize-handle
  background: activeColor
  border: 1px solid backgroundColor
  border-radius: 2px
  bottom: -4px
  cursor: nwse-resize
  height: 8px
  pointer-events: auto
  position: absolute
  right: -4px
  width: 8px

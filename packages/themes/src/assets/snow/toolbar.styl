.lxr-toolbar.lxr-snow
  border: 1px solid borderColor
  box-sizing: border-box
  font-family: 'Helvetica Neue', 'Helvetica', 'Arial', sans-serif
  padding: 8px

  .lxr-formats
    margin-right: 15px

  .lxr-picker-label
    border: 1px solid transparent
  .lxr-picker-options
    border: 1px solid transparent
    box-shadow: rgba(0,0,0,0.2) 0 2px 8px
  .lxr-picker.lxr-expanded
    .lxr-picker-label
      border-color: borderColor
    .lxr-picker-options
      border-color: borderColor

  .lxr-color-picker
    .lxr-picker-item.lxr-selected, .lxr-picker-item:hover
      border-color: #000

.lxr-toolbar.lxr-snow + .lxr-container.lxr-snow
  border-top: 0px;

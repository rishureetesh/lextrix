.lxt-toolbar.lxt-snow
  border: 1px solid borderColor
  box-sizing: border-box
  font-family: 'Helvetica Neue', 'Helvetica', 'Arial', sans-serif
  padding: 8px

  .lxt-formats
    margin-right: 15px

  .lxt-picker-label
    border: 1px solid transparent
  .lxt-picker-options
    border: 1px solid transparent
    box-shadow: rgba(0,0,0,0.2) 0 2px 8px
  .lxt-picker.lxt-expanded
    .lxt-picker-label
      border-color: borderColor
    .lxt-picker-options
      border-color: borderColor

  .lxt-color-picker
    .lxt-picker-item.lxt-selected, .lxt-picker-item:hover
      border-color: #000

.lxt-toolbar.lxt-snow + .lxt-container.lxt-snow
  border-top: 0px;

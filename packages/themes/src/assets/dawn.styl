themeName = 'dawn'
activeColor = #7c3aed
borderColor = #e7e0d8
backgroundColor = #fffbf7
inactiveColor = #8b7fb8
shadowColor = rgba(124, 58, 237, 0.14)
textColor = #44403c
accentSoft = #ffedd5

@import './core'
@import './base'
@import './dawn/*'

.lxr-dawn
  a
    color: activeColor

.lxr-container.lxr-dawn
  border: 1px solid borderColor
  background-color: backgroundColor

  .lxr-editor blockquote
    border-left-color: #fdba74
    background-color: accentSoft

  .lxr-editor code
    background-color: #fef3c7
    color: #78350f

  .lxr-editor.lxr-blank::before
    color: rgba(68, 64, 60, 0.45)

.lxr-toolbar.lxr-dawn
  background-color: #fff7ed

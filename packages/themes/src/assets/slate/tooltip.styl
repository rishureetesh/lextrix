tooltipMargin = 8px

.lxr-slate
  .lxr-tooltip
    background-color: toolbarBackground
    border: 1px solid borderColor
    box-shadow: 0 4px 16px shadowColor
    color: textColor
    padding: 5px 12px
    white-space: nowrap
    &::before
      content: "Visit URL:"
      line-height: 26px
      margin-right: tooltipMargin
    input[type=text]
      display: none
      border: 1px solid borderColor
      background-color: editorBackground
      color: textColor
      font-size: 13px
      height: 26px
      margin: 0px
      padding: 3px 5px
      width: 170px
    a.lxr-preview
      display: inline-block
      max-width: 200px
      overflow-x: hidden
      text-overflow: ellipsis
      vertical-align: top
      color: activeColor
    a.lxr-action::after
      border-right: 1px solid borderColor
      content: 'Edit'
      margin-left: tooltipMargin*2
      padding-right: tooltipMargin
    a.lxr-remove::before
      content: 'Remove'
      margin-left: tooltipMargin
    a
      line-height: 26px
  .lxr-tooltip.lxr-editing
    a.lxr-preview, a.lxr-remove
      display: none
    input[type=text]
      display: inline-block
    a.lxr-action::after
      border-right: 0px
      content: 'Save'
      padding-right: 0px
  .lxr-tooltip[data-mode=link]::before
    content: "Enter link:"
  .lxr-tooltip[data-mode=formula]::before
    content: "Enter formula:"
  .lxr-tooltip[data-mode=video]::before
    content: "Enter video:"

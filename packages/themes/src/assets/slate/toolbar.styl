.lxr-toolbar.lxr-slate
  border: 1px solid borderColor
  box-sizing: border-box
  font-family: 'Inter', 'Segoe UI', system-ui, sans-serif
  padding: 8px
  background-color: toolbarBackground

  .lxr-formats
    margin-right: 15px

  .lxr-picker-label
    border: 1px solid transparent
  .lxr-picker-options
    border: 1px solid borderColor
    box-shadow: shadowColor 0 4px 16px
    background-color: toolbarBackground
  .lxr-picker.lxr-expanded
    .lxr-picker-label
      border-color: borderColor
    .lxr-picker-options
      border-color: borderColor

  .lxr-color-picker
    .lxr-picker-item.lxr-selected, .lxr-picker-item:hover
      border-color: activeColor

.lxr-toolbar.lxr-slate + .lxr-container.lxr-slate
  border-top: 0px

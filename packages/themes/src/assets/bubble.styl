themeName = 'bubble'
activeColor = #ffffff
borderColor = #64748b
backgroundColor = #334155
inactiveColor = #c7d2fe
shadowColor = rgba(99, 102, 241, 0.35)
textColor = #f8fafc

@import './core'
@import './base'
@import './bubble/*'

.lxr-container.lxr-bubble:not(.lxr-disabled)
  a:not(.lxr-close)
    position: relative
    white-space: nowrap
  a:not(.lxr-close)::before
    background-color: #444
    border-radius: 15px
    top: -5px
    font-size: 12px
    color: #fff
    content: attr(href)
    font-weight: normal
    overflow: hidden
    padding: 5px 15px
    text-decoration: none
    z-index: 1
  a:not(.lxr-close)::after
    border-top: 6px solid #444
    border-left: 6px solid transparent
    border-right: 6px solid transparent
    top: 0
    content: " "
    height: 0
    width: 0
  a:not(.lxr-close)::before, a:not(.lxr-close)::after
    left: 0
    margin-left: 50%
    position: absolute
    transform: translate(-50%, -100%)
    transition: visibility 0s ease 200ms
    visibility: hidden
  a:not(.lxr-close):hover::before, a:not(.lxr-close):hover::after
    visibility: visible

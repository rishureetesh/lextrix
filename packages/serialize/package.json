{
  "name": "lextrix-serialize",
  "version": "2.0.4",
  "description": "Lextrix content serialization — import/export between ChangeSet and HTML, Markdown, MDX, JSON",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./html": "./src/html/html-serializer.ts",
    "./markdown": "./src/markdown/markdown-serializer.ts",
    "./mdx": "./src/mdx/mdx-serializer.ts",
    "./json": "./src/json/json-serializer.ts",
    "./equivalence": "./src/equivalence.ts"
  },
  "dependencies": {
    "lextrix-change": "2.0.4"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^26.1.0",
    "lextrix-core": "2.0.4",
    "lextrix-dom": "2.0.4",
    "lextrix-formats": "2.0.4",
    "lextrix-modules": "2.0.4",
    "vitest": "^3.2.4"
  }
}

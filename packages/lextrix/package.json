{
  "name": "lextrix",
  "version": "2.0.1",
  "description": "Modular TypeScript rich-text editor engine with themes, plugins, ChangeSet OT, and a familiar web API.",
  "author": "Reetesh Kumar (https://iamreetesh.com/me)",
  "homepage": "https://iamreetesh.com/lextrix",
  "main": "lextrix.js",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rishureetesh/lextrix.git",
    "directory": "packages/lextrix"
  },
  "bugs": {
    "url": "https://github.com/rishureetesh/lextrix/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/dist/lextrix.esm.js",
      "default": "./dist/dist/lextrix.js"
    },
    "./core": {
      "import": "./dist/dist/lextrix.core.esm.js",
      "default": "./dist/dist/lextrix.core.js"
    },
    "./lextrix.css": "./dist/dist/lextrix.core.css",
    "./snow.css": "./dist/dist/lextrix.snow.css",
    "./bubble.css": "./dist/dist/lextrix.bubble.css",
    "./slate.css": "./dist/dist/lextrix.slate.css",
    "./dawn.css": "./dist/dist/lextrix.dawn.css"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "lextrix-change": "2.0.1",
    "lextrix-core": "2.0.1",
    "lextrix-dom": "2.0.1",
    "lextrix-formats": "2.0.1",
    "lextrix-modules": "2.0.1",
    "lextrix-serialize": "2.0.1",
    "lextrix-themes": "2.0.1",
    "lextrix-ui": "2.0.1",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.60.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.0",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/browser": "^3.2.4",
    "babel-loader": "^9.2.1",
    "babel-plugin-transform-define": "^2.1.4",
    "css-loader": "^6.11.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-import-resolver-webpack": "^0.13.11",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-require-extensions": "^0.1.3",
    "glob": "^11.0.3",
    "highlight.js": "^11.11.1",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.7",
    "jsdom": "^26.1.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.8.3",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "stylus": "^0.64.0",
    "stylus-loader": "^8.1.2",
    "svgo": "^3.3.3",
    "terser-webpack-plugin": "^5.6.1",
    "transpile-webpack-plugin": "^1.1.3",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.4",
    "webpack-merge": "^6.0.1"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs production",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint src test --ext .ts,.tsx --ignore-path .eslintignore",
    "lint:tsc": "tsc --noEmit --skipLibCheck",
    "start": "webpack serve --config webpack.config.cjs",
    "test": "run-s test:*",
    "test:unit": "vitest --config test/unit/vitest.config.ts",
    "test:fuzz": "vitest --config test/fuzz/vitest.config.ts",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "editor",
    "rich-text",
    "rich-text-editor",
    "wysiwyg",
    "typescript",
    "contenteditable",
    "text-editor",
    "document-editor",
    "plugin-system",
    "changeset",
    "operational-transformation",
    "ot",
    "formatting",
    "document-model",
    "framework-agnostic",
    "web-editor",
    "html-editor",
    "editor-engine",
    "headless-editor",
    "extensible"
  ],
  "engines": {
    "node": ">=18"
  },
  "prettier": {
    "singleQuote": true
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ]
}

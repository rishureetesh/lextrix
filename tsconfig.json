{
  "ts-node": {
    "compilerOptions": {
      "esModuleInterop": true,
      "module": "commonjs"
    }
  },
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "declaration": false,
    "module": "ES2020",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "paths": {
      "lextron-change": ["./packages/change/src/index.ts"],
      "lextron-dom": ["./packages/dom/src/index.ts"],
      "lextron-core": ["./packages/core/src/index.ts"],
      "lextron-core/core/*": ["./packages/core/src/core/*"],
      "lextron-core/blots/*": ["./packages/core/src/blots/*"],
      "lextron-core/*": ["./packages/core/src/*"],
      "lextron-formats": ["./packages/formats/src/index.ts"],
      "lextron-formats/formats/*": ["./packages/formats/src/formats/*"],
      "lextron-formats/*": ["./packages/formats/src/*"],
      "lextron-modules": ["./packages/modules/src/index.ts"],
      "lextron-modules/modules/*": ["./packages/modules/src/modules/*"],
      "lextron-modules/*": ["./packages/modules/src/*"],
      "lextron-ui": ["./packages/ui/src/index.ts"],
      "lextron-ui/*": ["./packages/ui/src/*"],
      "lextron-themes": ["./packages/themes/src/index.ts"],
      "lextron-themes/*": ["./packages/themes/src/themes/*", "./packages/themes/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/lextron/test/**/*.ts",
    "packages/change/tests/**/*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/storybook-static"]
}
